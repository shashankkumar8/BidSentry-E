# Get your API key from TinyFish, then set it here. Never commit .env.
TINYFISH_API_KEY=replace_with_your_tinyfish_api_key

# Optional: set a path for the local tender-change history database.
# BIDSENTRY_DB_PATH=.bidsentry.db

# Optional: current applicable Agent cost per reported step (estimate only).
# TINYFISH_AGENT_STEP_USD=0.016

# Optional path for the local metadata-only API audit ledger.
BIDSENTRY_AUDIT_DB_PATH=audit_logs.db
